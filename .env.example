# Zillow-Proof AVM MCP configuration

# Transport for `zillow-proof-avm serve`
ZPAVM_TRANSPORT=stdio
ZPAVM_HOST=127.0.0.1
ZPAVM_PORT=8010

# Comp source: JSON file, either a list of comps or {"comps": [...]}
ZPAVM_COMPS_FILE=

# Data sources (fill in when wiring live providers)
ZPAVM_USER_AGENT=
ZPAVM_RENTCAST_API_KEY=
ZPAVM_CENSUS_API_KEY=
